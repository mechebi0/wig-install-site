# =============================================================================
# CROWNED BY NAT - environment variables
# =============================================================================
# Copy this file to `.env.local` for local development and fill in the values
# from your Supabase project. `.env.local` is git-ignored and must stay that
# way; this file carries NAMES ONLY and never a real value.
#
# The same two variables have to be set in the Cloudflare Pages project, under
# Settings -> Environment variables, for BOTH the Production and the Preview
# environment. They are read at BUILD time and compiled into the JavaScript, so
# adding them is not enough on its own: the site has to be rebuilt afterwards
# (Deployments -> Retry deployment) before they take effect.
#
# Find both values in Supabase at Project Settings -> API.
# -----------------------------------------------------------------------------

# Your project's API URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The ANON / PUBLIC key. Also labelled "publishable" in newer dashboards.
#
# This one is meant to be public. It is compiled into the browser bundle and
# anyone can read it out of the deployed site, which is fine: it carries the
# `anon` Postgres role, and everything that role can do is bounded by the row
# level security policies in supabase/migrations/. It is an identifier, not a
# password.
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# =============================================================================
# NEVER PUT THIS ANYWHERE IN THIS PROJECT
# =============================================================================
# SUPABASE_SERVICE_ROLE_KEY
#
# The service role key bypasses row level security completely. Anyone holding
# it can read every customer's phone number and appointment history and delete
# the lot.
#
# This deployment is a static export. There is no server runtime, no API route
# and no server action anywhere in it, which means there is nowhere for a
# secret to live that the browser cannot reach. Adding the service role key to
# Cloudflare Pages would not "keep it on the server"; there is no server. If it
# is ever prefixed with NEXT_PUBLIC_ it is published to the internet on the
# next deploy.
#
# If a future feature genuinely needs it (a nightly reminder job, an admin
# export), it belongs in a Supabase Edge Function or a separate Cloudflare
# Worker, with the key set as a secret THERE and never in this project.
# =============================================================================


# -----------------------------------------------------------------------------
# OPTIONAL, PRE-EXISTING
# -----------------------------------------------------------------------------
# Used only by the fallback email request form on /book, which renders when
# Supabase is not configured. A form endpoint (Formspree, a Worker, anything
# that accepts a JSON POST). Leave empty and that form opens a prefilled email
# to the studio instead.
NEXT_PUBLIC_BOOKING_ENDPOINT=


# -----------------------------------------------------------------------------
# OPTIONAL, NOT YET IN USE
# -----------------------------------------------------------------------------
# Nat's Acuity Scheduling link, once she has an account. There is none today,
# so this is empty and every booking button on the site points at /book, which
# is the correct behaviour and needs no configuration at all.
#
# When she does have one: paste the scheduler URL here for local work, and set
# the same variable in Cloudflare Pages (Settings -> Environment variables,
# Production AND Preview), then redeploy. Every booking CTA on the site swaps
# over at once, including the six Book buttons on the collection cards, and the
# on-page request form hides itself. Nothing else needs editing.
#
# The collection cards append `?style=<collection-slug>` to whatever is here,
# so the style the visitor picked survives the click. If the URL you paste
# already has a query string, that is handled: see bookingTarget() in
# lib/content.ts.
#
# No API key, no account ID and no integration is involved. It is one URL.
NEXT_PUBLIC_ACUITY_BOOKING_URL=
